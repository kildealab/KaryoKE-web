# Copy this file to .env and adjust it for this machine. Everything has a default.
# DEVELOPMENT=true on your own computer (test server on http://localhost:PORT);
# leave it out or false on the VPS (gunicorn on the unix socket SOCKET_PATH, for nginx).
DEVELOPMENT=
TEMP_FOLDER=
PORT=
SOCKET_PATH=
WORKERS = 
KEEP_MINUTES=
MAX_INPUT_MB=
TIMEOUT_SECONDS=
MAX_JOBS=
SECRET_KEY=
